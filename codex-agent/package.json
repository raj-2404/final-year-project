{
  "name": "codex-agent",
  "version": "1.0.0",
  "description": "Secure local CLI terminal agent for CodeX editor providing real PTY sessions",
  "main": "dist/index.js",
  "bin": {
    "codex-agent": "./bin/codex-agent.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli/index.ts start",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "codex",
    "terminal",
    "pty",
    "agent",
    "cli"
  ],
  "author": "CodeX Team",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "commander": "^15.0.0",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
